{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-sys main.ts",
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "mongodb": "npm:mongodb@^7.1.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
